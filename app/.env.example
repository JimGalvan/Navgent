# Reference settings for the repository-root .env; merge with existing agent settings.
REPROBE_PREVIEW=true
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate a Fernet key using cryptography.fernet.Fernet.generate_key().
WORKOS_COOKIE_PASSWORD=
OPENAI_API_KEY=
REPROBE_HEADLESS=true
REPROBE_EVIDENCE_MODEL=openai:gpt-5-nano
REPROBE_MAX_CONCURRENT_RUNS=3
# Optional: base64-encoded 32-byte key for saved target-site credentials.
REPROBE_CREDENTIAL_KEY=
# local launches Chromium on this machine; docker uses the installed sandboxctl.
REPROBE_SANDBOX=local
# Optional persistent data path; defaults to app/.data.
REPROBE_DATA_DIR=
